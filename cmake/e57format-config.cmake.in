include(CMakeFindDependencyMacro)

if("@E57_XML_PARSER@" STREQUAL "XERCES")
    find_dependency(XercesC 3.2)
elseif("@E57_XML_PARSER@" STREQUAL "EXPAT")
    find_dependency(EXPAT)
elseif("@E57_XML_PARSER@" STREQUAL "TINYXML2")
    find_package(tinyxml2 QUIET)
    if(NOT tinyxml2_FOUND)
        find_dependency(PkgConfig)
        pkg_search_module(tinyxml2 REQUIRED IMPORTED_TARGET tinyxml2)
    endif()
endif()
include(${CMAKE_CURRENT_LIST_DIR}/E57Format-export.cmake)

set_target_properties(E57Format PROPERTIES
    MAP_IMPORTED_CONFIG_MINSIZEREL "MinSizeRel;Release"
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO "RelWithDebInfo;Release"
)
